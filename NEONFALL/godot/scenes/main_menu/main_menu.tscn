[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_Menu"]
script/source = "extends Control

func _on_play_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/gameplay/gameplay.tscn\")
"

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_Menu")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -160.0
offset_top = -100.0
offset_right = 160.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "NEONFALL: RISE OF MACHINES"
horizontal_alignment = 1

[node name="PlayButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "INICIAR INCURSÃO 3D"

[connection signal="pressed" from="VBoxContainer/PlayButton" to="." method="_on_play_pressed"]
